# MandiFlow Backend Environment Variables (Optional)
# If left unset, the backend runs in simulated notification mode with zero crashes.

# Twilio SMS Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Twilio WhatsApp Sandbox (defaults to sandbox number +14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Port (set automatically by hosting providers like Render)
PORT=8000
